{
  "name": "nexus-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nexus Arena — a full-stack, original esports tournament management platform (Free Fire style, non-affiliated).",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "start": "node server/index.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test server/tests/*.test.js",
    "admin:create": "node scripts/create-admin.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "build:functions": "node functions/build.mjs",
    "deploy:firebase": "npm run build:functions && firebase deploy --only functions,firestore:rules,storage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase": "^11.6.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
