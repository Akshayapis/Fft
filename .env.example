# ─────────────────────────────────────────────────────────────
# Nexus Arena — local/self-hosted backend configuration
# Copy to .env (or export in your shell). No credentials are invented
# by this project; supply your own.
# ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
DATA_DIR=./server/data
# Created once on first boot if set. Prefer `npm run admin:create` instead.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional Google Identity Services (shown in UI only when configured)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Optional SMTP for verification / password reset mail (dev outbox used otherwise)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexus Arena <no-reply@example.com>"
# Dev-only helper: expose the local mail outbox at /api/dev/outbox
DEV_SHOW_TOKENS=true
# Absolute URL the browser uses to reach the API (leave empty for same origin)
VITE_API_BASE_URL=
# ─── Firebase backend (optional production mode) ───
# VITE_BACKEND=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_URL=
